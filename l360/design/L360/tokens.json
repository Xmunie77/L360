{
  "$meta": {
    "name": "Learning 360 Foundation design tokens",
    "version": "2.0.0",
    "date": "2026-08-27",
    "extractedFrom": "learning360.org.mt theme stylesheet app.e0b7d1.css and served PNG assets",
    "note": "Values with source 'extracted' are the live brand. Values with source 'added' are new and need founder sign-off. Contrast ratios are WCAG 2.1, computed against #FFFFFF unless stated."
  },
  "color": {
    "brand": {
      "orange":      { "value": "#FE9345", "source": "extracted", "onWhite": 2.22, "use": "FILL ONLY — never text on light grounds" },
      "orangeDeep":  { "value": "#AD4900", "source": "added",     "onWhite": 5.63, "use": "links, orange text and icons on light" },
      "orangeTint":  { "value": "#FFF1E6", "source": "added",     "inkOnIt": 14.72, "use": "selected slot / hover row ground" }
    },
    "neutral": {
      "ink":      { "value": "#202020", "source": "extracted", "onWhite": 16.29 },
      "dgrey":    { "value": "#373737", "source": "extracted" },
      "bgrey":    { "value": "#424242", "source": "extracted", "onWhite": 10.05 },
      "lgrey":    { "value": "#E0E0E0", "source": "extracted" },
      "mute":     { "value": "#6E6E6E", "source": "added", "onWhite": 5.10, "use": "captions, hints, metadata" },
      "disabled": { "value": "#969696", "source": "extracted", "onWhite": 2.96, "use": "DISABLED CONTROLS ONLY — fails AA, must not carry readable text" },
      "white":    { "value": "#FFFFFF", "source": "extracted" }
    },
    "state": {
      "success":   { "value": "#0F7A4A", "source": "added", "onWhite": 5.38 },
      "successBg": { "value": "#E8F5EE", "source": "added" },
      "danger":    { "value": "#B3261E", "source": "added", "onWhite": 6.54 },
      "dangerBg":  { "value": "#FDECEA", "source": "added" },
      "info":      { "value": "#1B5E9C", "source": "added", "onWhite": 6.71 },
      "infoBg":    { "value": "#E7F0F8", "source": "added" },
      "pending":   { "value": "#5F5F5F", "source": "added", "onWhite": 6.39 },
      "pendingBg": { "value": "#F1F1F1", "source": "added" },
      "$note": "No amber warning colour exists by design — amber is indistinguishable from the brand orange. Use info or pending instead."
    },
    "focus": { "ring": "#AD4900", "ringOnDark": "#FFFFFF", "width": "3px", "offset": "2px" }
  },
  "typography": {
    "family": { "value": "Work Sans", "fallback": "ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif", "source": "extracted" },
    "mono":   { "value": "ui-monospace, Menlo, Consolas, monospace", "source": "added", "use": "amounts, booking references" },
    "weight": { "light": 300, "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "t1": { "size": "3.125rem", "lineHeight": "3.75rem",  "role": "page hero" },
      "t2": { "size": "2.5rem",   "lineHeight": "2.812rem", "role": "section heading" },
      "t3": { "size": "1.875rem", "lineHeight": "2.187rem", "role": "step heading, total" },
      "t4": { "size": "1.375rem", "lineHeight": "1.75rem",  "role": "sub-heading" },
      "t5": { "size": "1.25rem",  "lineHeight": "1.562rem", "role": "card title" },
      "t6": { "size": "1.125rem", "lineHeight": "1.562rem", "role": "intro paragraph, weight 300" },
      "t7": { "size": "1rem",     "lineHeight": "1.375rem", "role": "body default" },
      "t8": { "size": "0.875rem", "lineHeight": "1.375rem", "role": "caption, hint" }
    },
    "eyebrow": { "size": "0.6875rem", "tracking": "0.14em", "transform": "uppercase", "weight": 600 },
    "rules": [
      "Body text never below 16px, including form fields",
      "Left aligned, ragged right — justified text is banned",
      "Line length 60-70 characters",
      "Sentence case everywhere except the eyebrow style",
      "Bold for emphasis, never italic"
    ]
  },
  "radius": { "sm": "0.25rem", "md": "0.5rem", "full": "9999px", "source": "extracted" },
  "space":  { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px", "source": "added" },
  "layout": { "maxWidth": "1080px", "formMaxWidth": "560px", "gutter": "24px", "pagePadding": "28px", "breakpoint": "820px", "source": "added" },
  "interaction": { "tapTargetMin": "44px", "slotHeightMin": "48px", "ease": "150ms ease", "source": "added" }
}
